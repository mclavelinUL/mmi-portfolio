{
  "name": "mmi-portfolio",
  "version": "1.2.0",
  "private": true,
  "description": "Assets du plugin WordPress MMI Portfolio",
  "scripts": {
    "build": "sass templates/src/portfolio.scss templates/portfolio.css --style=compressed --no-source-map",
    "dev": "sass --watch templates/src/portfolio.scss templates/portfolio.css --style=expanded",
    "fonts": "node scripts/copy-fonts.mjs",
    "postinstall": "node scripts/copy-fonts.mjs"
  },
  "devDependencies": {
    "sass": "^1.80.0",
    "@fontsource-variable/source-serif-4": "^5.1.0"
  }
}
